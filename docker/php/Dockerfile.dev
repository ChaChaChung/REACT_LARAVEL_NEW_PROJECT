# == Build stage: Composer 用來複製 binary ==
FROM composer:latest AS composer_stage

# == 開發環境主 image ==
FROM php:8.4-fpm
# Set timezone early
ENV TZ=Asia/Taipei
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Install system dependencies, PHP extensions, and dev tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl git zip unzip libzip-dev libonig-dev \
    libpng-dev libjpeg-dev libfreetype6-dev libwebp-dev libxpm-dev \
    libxml2-dev \
    gnupg procps \
    # Puppeteer 所需的依賴
    chromium \
    fonts-liberation \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libx11-6 \
    libxcb1 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js using NodeSource repository (more reliable)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Configure and install PHP extensions, including Xdebug
RUN docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install -j$(nproc) pdo_mysql zip gd bcmath opcache soap \
    && pecl install xdebug \
    && docker-php-ext-enable xdebug


# Install Composer tool
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# 安裝 Puppeteer（全域安裝）
RUN npm install -g puppeteer --unsafe-perm=true --allow-root

# 設置 Puppeteer 使用系統的 Chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true \
    PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /var/www/html

# *** IMPORTANT CHANGE FOR DEVELOPMENT ***
# We are NOT copying application code here.
# Instead, your source code will be mounted as a volume via docker-compose.yml.
# This allows for instant code changes without rebuilding the Docker image.

# Create necessary directories and set initial permissions
# These directories will likely be mounted, but ensuring they exist and have correct ownership
# is good for consistency if they're empty on the host

# Create error log file if needed, ensure www-data can write to it
RUN touch /var/log/php_error.log && chown www-data:www-data /var/log/php_error.log


# ==============================
# 🚀 這裡是重點：建立與宿主機相同 UID/GID 的開發用使用者
# ==============================
ARG UID=1000
ARG GID=1000
ARG USERNAME=deployer

RUN groupadd -g $GID $USERNAME \
    && useradd -m -u $UID -g $GID -s /bin/bash $USERNAME \
    && mkdir -p /var/www/html \
    && chown -R $USERNAME:$USERNAME /var/www/html

USER $USERNAME

